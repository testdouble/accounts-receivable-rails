<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title>AccountsReceivable</title>
    <%= csrf_meta_tags %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <!-- This is needed because the tailwind CSS/JS assets from Rails pipeline are not setup/do not work correctly -->
    <!-- RequiresJS layouts are broken with pipeline assets -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="h-full">
    <div class="min-h-full">
      <%= render "layouts/top_bar" %>

      <div class="py-10">
        <main>
          <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
