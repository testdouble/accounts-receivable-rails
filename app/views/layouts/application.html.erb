<!DOCTYPE html>
<html>
  <head>
    <title>AccountsReceivable</title>
    <%= csrf_meta_tags %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="container text-blue-700">
      <nav>
        <ul>
          <li><%= link_to "Clients", clients_path %></li>
          <li><%= link_to "Products", products_path %></li>
          <li><%= link_to "Services", services_path %></li>
          <li><%= link_to "Invoices", invoices_path %></li>
          <li><%= link_to "Line Items", line_items_path %></li>
        </ul>
      </nav>
      <div class="main">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
